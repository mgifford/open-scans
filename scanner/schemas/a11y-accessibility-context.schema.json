{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgifford.github.io/open-scans/scanner/schemas/a11y-accessibility-context.schema.json",
  "title": "AccessibilityContext",
  "description": "Occurrence-level accessibility evidence for joining to an external component graph. It is not a component graph or an ownership claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "site", "scan", "summary", "categoryLabels", "observations", "limitations"],
  "properties": {
    "schema": { "type": "string", "const": "a11y-accessibility-context/1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "host"],
      "properties": {
        "origin": { "type": ["string", "null"] },
        "host": { "type": ["string", "null"] }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "issueUrl", "scanTitle", "scannedAt", "engines", "scanContext"],
      "properties": {
        "issueNumber": { "type": ["integer", "null"] },
        "issueUrl": { "type": ["string", "null"] },
        "scanTitle": { "type": ["string", "null"] },
        "scannedAt": { "type": ["string", "null"] },
        "engines": { "type": "array", "items": { "type": "string" } },
        "scanContext": { "type": ["object", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations", "pages", "patterns", "withSelector", "htmlOnly", "withoutLocator", "byCategory", "ownershipEstablished", "note"],
      "properties": {
        "observations": { "type": "integer", "minimum": 0 },
        "pages": { "type": "integer", "minimum": 0 },
        "patterns": { "type": "integer", "minimum": 0 },
        "withSelector": { "type": "integer", "minimum": 0 },
        "htmlOnly": { "type": "integer", "minimum": 0 },
        "withoutLocator": { "type": "integer", "minimum": 0 },
        "byCategory": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "ownershipEstablished": { "type": "boolean", "const": false },
        "note": { "type": "string" }
      }
    },
    "categoryLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observationId", "patternId", "patternDisplayId", "identitySource", "rule", "engine",
          "wcagSc", "actRuleIds", "impact", "pageUrl", "selector", "locator", "locatorSource",
          "container", "sourceRef"
        ],
        "properties": {
          "observationId": { "type": "string" },
          "patternId": { "type": "string" },
          "patternDisplayId": { "type": "string" },
          "identitySource": { "type": "string", "enum": ["canonical", "legacy", "derived"] },
          "rule": { "type": "string" },
          "engine": { "type": "string" },
          "wcagSc": { "type": "array", "items": { "type": "string" } },
          "actRuleIds": { "type": "array", "items": { "type": "string" } },
          "impact": { "type": ["string", "null"] },
          "pageUrl": { "type": "string" },
          "selector": { "type": ["string", "null"] },
          "locator": { "type": "string" },
          "locatorSource": { "type": "string", "enum": ["selector", "html", "none"] },
          "container": { "type": "object" },
          "sourceRef": { "type": ["string", "null"] }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
