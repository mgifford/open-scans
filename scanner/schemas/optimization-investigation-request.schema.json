{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgifford.github.io/open-scans/scanner/schemas/optimization-investigation-request.schema.json",
  "title": "OptimizationInvestigationRequest",
  "description": "Opt-in description of the performance or energy optimization being reviewed. It does not execute a scan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scenarios"],
  "properties": {
    "schema": { "type": "string", "const": "optimization-investigation-request/1" },
    "reviewer": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "removing-unused-javascript",
              "deferring-script-execution",
              "replacing-navigation",
              "lazy-loading-images-or-embeds",
              "reducing-or-removing-animation",
              "replacing-third-party-widgets",
              "simplifying-dom",
              "removing-unnecessary-css",
              "changing-progressive-enhancement",
              "replacing-component-with-lighter-alternative"
            ]
          },
          "description": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" } },
          "pages": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
