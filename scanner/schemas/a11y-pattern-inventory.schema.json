{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgifford.github.io/open-scans/scanner/schemas/a11y-pattern-inventory.schema.json",
  "title": "AccessibilityPatternInventory",
  "description": "Unique accessibility patterns grouped by stable pattern identity and a conservative semantic-container candidate. It is not a component graph or an ownership claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "summary", "categoryLabels", "patterns"],
  "properties": {
    "schema": { "type": "string", "const": "a11y-pattern-inventory/1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uniquePatterns", "occurrences", "pages", "categories", "byCategory", "byContainerElement", "byComponentId", "unassignedPatterns", "ownershipEstablished", "note"],
      "properties": {
        "uniquePatterns": { "type": "integer", "minimum": 0 },
        "occurrences": { "type": "integer", "minimum": 0 },
        "pages": { "type": "integer", "minimum": 0 },
        "categories": { "type": "integer", "minimum": 0 },
        "byCategory": { "$ref": "#/$defs/index" },
        "byContainerElement": { "$ref": "#/$defs/index" },
        "byComponentId": { "$ref": "#/$defs/index" },
        "unassignedPatterns": { "type": "integer", "minimum": 0 },
        "ownershipEstablished": { "type": "boolean", "const": false },
        "note": { "type": "string" }
      }
    },
    "categoryLabels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    }
  },
  "$defs": {
    "index": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["patterns", "occurrences", "pages", "patternIds"],
        "properties": {
          "patterns": { "type": "integer" },
          "occurrences": { "type": "integer" },
          "pages": { "type": "integer" },
          "patternIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId", "displayId", "identitySource", "legacyPatternId", "canonicalPatternFingerprint",
        "engine", "engineLabel", "rule", "wcagSc", "actRuleIds", "impact", "category",
        "container", "occurrenceCount", "pageCount", "pages", "firstSeenAt", "lastSeenAt", "examples"
      ],
      "properties": {
        "patternId": { "type": "string" },
        "displayId": { "type": "string" },
        "identitySource": { "type": "string", "enum": ["canonical", "legacy", "derived"] },
        "legacyPatternId": { "type": ["string", "null"] },
        "canonicalPatternFingerprint": { "type": ["string", "null"] },
        "engine": { "type": "string" },
        "engineLabel": { "type": "string" },
        "rule": { "type": "string" },
        "wcagSc": { "type": "array", "items": { "type": "string" } },
        "actRuleIds": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": ["string", "null"] },
        "category": { "type": "string" },
        "container": { "$ref": "#/$defs/container" },
        "occurrenceCount": { "type": "integer", "minimum": 1 },
        "pageCount": { "type": "integer", "minimum": 1 },
        "pages": { "type": "array", "items": { "type": "string" } },
        "firstSeenAt": { "type": ["string", "null"] },
        "lastSeenAt": { "type": ["string", "null"] },
        "examples": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pageUrl", "locator", "html"],
            "properties": {
              "pageUrl": { "type": "string" },
              "locator": { "type": "string" },
              "html": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "label", "element", "componentId", "componentTypeId", "componentLabel", "basis", "confidence", "ownershipEstablished", "uncertainty"],
      "properties": {
        "category": { "type": "string" },
        "label": { "type": "string" },
        "element": { "type": ["string", "null"] },
        "componentId": { "type": ["string", "null"] },
        "componentTypeId": { "type": ["string", "null"] },
        "componentLabel": { "type": ["string", "null"] },
        "basis": { "type": "string", "enum": ["explicit-component", "selector-token", "none"] },
        "confidence": { "type": "string", "enum": ["high", "low", "unknown"] },
        "ownershipEstablished": { "type": "boolean", "const": false },
        "uncertainty": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
