{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgifford.github.io/open-scans/scanner/schemas/a11y-observation.schema.json",
  "title": "AccessibilityObservationArtifact",
  "description": "Normalized, evidence-preserving engine observations for one scan. One observation is one thing one engine said about one target in one execution. Observations are never removed by grouping; cross-engine equivalence stays unclaimed until target resolution and rule semantics prove it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "scan",
    "documents",
    "counts",
    "reconciliation",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "a11y-observation/1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "issueNumber": {
      "type": [
        "integer",
        "null"
      ]
    },
    "scanTitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enginesRequested",
        "engineExecution",
        "engineVersions"
      ],
      "properties": {
        "scannedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "scanContext": {
          "type": [
            "object",
            "null"
          ]
        },
        "enginesRequested": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engineExecution": {
          "type": [
            "object",
            "null"
          ]
        },
        "engineVersions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawFailures",
        "observations",
        "repeatedWithinEngine",
        "crossEngineEquivalent",
        "relatedFindings",
        "provisionalIssues",
        "unknownRuleObservations",
        "distinctResolvedTargets",
        "unresolvedTargets",
        "ambiguousLocators",
        "byEngine",
        "byLocatorType"
      ],
      "properties": {
        "rawFailures": {
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "type": "integer",
          "minimum": 0
        },
        "repeatedWithinEngine": {
          "type": "integer",
          "minimum": 0
        },
        "crossEngineEquivalent": {
          "type": "integer",
          "minimum": 0
        },
        "relatedFindings": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedTargets": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguousLocators": {
          "type": "integer",
          "minimum": 0
        },
        "byEngine": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "byLocatorType": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "unknownRuleObservations": {
          "type": "integer",
          "minimum": 0
        },
        "unknownRuleByEngine": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "resolvedObservations": {
          "type": "integer",
          "minimum": 0
        },
        "distinctResolvedTargets": {
          "type": "integer",
          "minimum": 0
        },
        "provisionalIssues": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawFailuresEqualObservations",
        "groupingPreservesObservations",
        "crossEngineEquivalentVerified"
      ],
      "properties": {
        "rawFailuresEqualObservations": {
          "type": "boolean"
        },
        "groupingPreservesObservations": {
          "type": "boolean"
        },
        "crossEngineEquivalentVerified": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "available",
          "documentHash",
          "nodes"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "documentHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "nodes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "observationId",
        "engine",
        "outcome",
        "nativeOutcome",
        "url",
        "testContext",
        "target",
        "htmlEvidence",
        "message",
        "actRuleIds",
        "mapping",
        "wcagSc",
        "severity",
        "rawEvidenceRef",
        "executionStatus",
        "fixtureId",
        "relations",
        "document"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "observationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Full SHA-256 digest. Never a human-readable short hash."
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "label",
            "version",
            "ruleId"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "ruleId": {
              "type": "string"
            }
          }
        },
        "outcome": {
          "type": "string",
          "enum": [
            "failed",
            "passed",
            "cantTell",
            "inapplicable",
            "untested"
          ]
        },
        "nativeOutcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "testContext": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "browser",
            "viewport",
            "colorScheme",
            "contextKey"
          ],
          "properties": {
            "browser": {
              "type": [
                "string",
                "null"
              ]
            },
            "viewport": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "width",
                    "height"
                  ],
                  "properties": {
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            "colorScheme": {
              "type": [
                "string",
                "null"
              ]
            },
            "contextKey": {
              "type": "string"
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nativeLocator",
            "locatorType",
            "specificLocator",
            "resolution",
            "resolutionMethod",
            "matchedElements",
            "resolvedTargetId",
            "candidates",
            "confidence",
            "ambiguity",
            "nativeLocatorField"
          ],
          "properties": {
            "nativeLocator": {
              "type": [
                "string",
                "null"
              ]
            },
            "locatorType": {
              "type": "string",
              "enum": [
                "xpath",
                "css",
                "html",
                "none"
              ]
            },
            "specificLocator": {
              "type": "boolean"
            },
            "resolution": {
              "type": "string",
              "enum": [
                "resolved",
                "unverified",
                "unresolved",
                "ambiguous",
                "unsupported"
              ]
            },
            "resolutionMethod": {
              "type": "string"
            },
            "matchedElements": {
              "type": [
                "integer",
                "null"
              ]
            },
            "resolvedTargetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "ambiguity": {
              "type": [
                "string",
                "null"
              ]
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "none"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "nativeLocatorField": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "xpath",
                "selector",
                "html",
                null
              ]
            }
          }
        },
        "htmlEvidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "actRuleIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "status",
            "verified",
            "evidence"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "mapped",
                "multi-mapped",
                "candidate",
                "unmapped",
                "inferred",
                "multi-inferred"
              ]
            },
            "verified": {
              "type": "boolean"
            },
            "evidence": {
              "type": "string",
              "enum": [
                "verified",
                "candidate",
                "unmapped",
                "inferred"
              ]
            }
          }
        },
        "wcagSc": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "rawEvidenceRef": {
          "type": "string",
          "description": "Stable pointer into the preserved report.json, e.g. report.json#/results/0/alfa/failures/3"
        },
        "executionStatus": {
          "type": "string",
          "enum": [
            "executed",
            "notRun",
            "unsupported",
            "error"
          ]
        },
        "fixtureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "repeatOf": {
          "type": "string"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "reason"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "repeated-observation",
                  "cross-engine-equivalent",
                  "related-finding",
                  "uncertain-match"
                ]
              },
              "of": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "evidenceRef": {
                "type": "string"
              }
            }
          }
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hash",
            "available",
            "source",
            "comparableAcrossEngines"
          ],
          "properties": {
            "hash": {
              "type": [
                "string",
                "null"
              ]
            },
            "available": {
              "type": "boolean"
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "comparableAcrossEngines": {
              "type": "string",
              "enum": [
                "unverified",
                "verified",
                "incomparable"
              ]
            }
          }
        }
      }
    }
  }
}
